{
  "id": "sample-detailed-leaderboard",
  "name": "Detailed Leaderboard",
  "version": "1.0.0",
  "description": "Comprehensive race leaderboard table displaying position, driver, elapsed time, laps, gap, best lap, and average lap times",
  "author": "Race Coordinator AI",
  "defaultWidth": 620,
  "defaultHeight": 460,
  "minWidth": 380,
  "minHeight": 220,
  "settingsSchema": [
    {
      "key": "title",
      "label": "Header Title",
      "type": "string",
      "default": ""
    },
    {
      "key": "maxRows",
      "label": "Max Rows (0 for all)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "col3Metric",
      "label": "Column 3 Metric",
      "type": "select",
      "default": "totalTime",
      "colorKey": "col3Color",
      "colorDefault": "#ffffff",
      "options": [
        { "label": "Total Time", "value": "totalTime" },
        { "label": "Total Laps", "value": "totalLaps" },
        { "label": "Gap to Leader", "value": "gapLeader" },
        { "label": "Gap to Position", "value": "gapPosition" },
        { "label": "Best Lap Time", "value": "bestLapTime" },
        { "label": "Last Lap Time", "value": "lastLapTime" },
        { "label": "Average Lap Time", "value": "averageLapTime" },
        { "label": "Median Lap Time", "value": "medianLapTime" },
        { "label": "Lane", "value": "lane" },
        { "label": "None (Hide Column)", "value": "none" }
      ]
    },
    {
      "key": "col4Metric",
